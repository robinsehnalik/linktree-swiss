---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
	profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;

const featuredSocials = [
	{ platform: 'youtube', label: 'YouTube', url: 'https://youtube.com', icon: 'tabler:brand-youtube' },
	{ platform: 'x', label: 'X / Twitter', url: 'https://x.com', icon: 'tabler:brand-x' },
	{ platform: 'instagram', label: 'Instagram', url: 'https://instagram.com', icon: 'tabler:brand-instagram' },
	{ platform: 'github', label: 'GitHub', url: 'https://github.com', icon: 'tabler:brand-github' },
];
---

<section class="pt-4 pb-6">
	<!-- Asymmetric Swiss layout: Photo on left, Big Bold Typography on right -->
	<div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 sm:gap-6 mb-6">
		<!-- Sharp Square Portrait with black border -->
		<div class="relative shrink-0">
			<div class="relative w-28 h-28 sm:w-32 sm:h-32 border-[2px] border-[#111111] bg-white p-1">
				<Image
					src={profile.avatar}
					alt={profile.name}
					width={256}
					height={256}
					loading="eager"
					fetchpriority="high"
					class="w-full h-full object-cover grayscale contrast-125"
				/>
			</div>

			<!-- Verified Vermillion tag -->
			<div
				class="absolute -bottom-2 -right-2 px-2 py-0.5 bg-[#ff3300] text-white font-mono text-[10px] font-black tracking-widest uppercase border border-[#111111] flex items-center gap-1 select-none"
			>
				<Icon name="tabler:check" size="1.2em" class="stroke-[3]" />
				<span>VERIFIED</span>
			</div>
		</div>

		<!-- Identity & Metadata -->
		<div class="flex-1 text-center sm:text-left space-y-2">
			<div class="flex items-center justify-center sm:justify-start gap-2 flex-wrap">
				<span class="inline-flex items-center px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider bg-[#111111] text-white">
					{profile.badge ?? 'DIGITAL CREATOR & DESIGNER'}
				</span>
				<span class="inline-flex items-center px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider border border-[#111111] bg-white text-[#111111]">
					SAN FRANCISCO, CA
				</span>
			</div>

			<h1 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tighter text-[#111111] m-0 leading-none">
				{profile.name}
			</h1>

			<p class="font-mono text-xs font-bold text-[#ff3300] m-0">
				{profile.handle}
			</p>
		</div>
	</div>

	<!-- Swiss Grid About Me Card with index marker -->
	<div class="w-full mb-6 border-[1.5px] border-[#111111] bg-white p-5 text-left">
		<div class="font-mono text-[11px] font-bold uppercase text-[#111111] pb-2 mb-3 border-b border-[#111111] flex items-center justify-between">
			<span class="tracking-widest flex items-center gap-1.5">
				<span class="w-2 h-2 bg-[#ff3300] inline-block"></span>
				ABOUT ME
			</span>
			<span class="text-[10px] text-[#777777] font-mono">SECT. 01</span>
		</div>
		<p class="text-[0.9375rem] text-[#222222] font-sans leading-relaxed m-0">
			{profile.bio}
		</p>
	</div>

	<!-- 3-column architectural stat grid -->
	<div class="grid grid-cols-3 border-[1.5px] border-[#111111] bg-white mb-6 divide-x-[1.5px] divide-[#111111]">
		<div class="p-3 text-center">
			<div class="text-xl sm:text-2xl font-black font-mono tracking-tight text-[#111111]">
				142K
			</div>
			<div class="text-[10px] font-mono font-bold uppercase tracking-widest text-[#666666] mt-0.5">
				SUBSCRIBERS
			</div>
		</div>

		<div class="p-3 text-center">
			<div class="text-xl sm:text-2xl font-black font-mono tracking-tight text-[#111111]">
				2.8M
			</div>
			<div class="text-[10px] font-mono font-bold uppercase tracking-widest text-[#666666] mt-0.5">
				TOTAL VIEWS
			</div>
		</div>

		<div class="p-3 text-center">
			<div class="text-xl sm:text-2xl font-black font-mono tracking-tight text-[#111111]">
				28K
			</div>
			<div class="text-[10px] font-mono font-bold uppercase tracking-widest text-[#666666] mt-0.5">
				NEWSLETTER
			</div>
		</div>
	</div>

	<!-- Square, razor-sharp Swiss social icon buttons -->
	<nav aria-label="Social profiles" class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5">
		{featuredSocials.map((social) => (
			<a
				href={social.url}
				target="_blank"
				rel="noopener noreferrer"
				class="swiss-button w-11 h-11 border-[1.5px] border-[#111111] bg-white text-[#111111]"
				aria-label={social.label}
				title={social.label}
			>
				<Icon name={social.icon} size="1.35em" />
			</a>
		))}
	</nav>
</section>
